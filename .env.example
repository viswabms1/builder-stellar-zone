# Environment Variables Template
# Copy this to .env and fill in your actual values

# Builder.io public key (optional)
VITE_PUBLIC_BUILDER_KEY=your_builder_public_key

# Ping message for API test
PING_MESSAGE="ping pong"

# OpenAI Configuration - REQUIRED
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI Agent Builder Workflow Configuration - REQUIRED
OPENAI_WORKFLOW_ID=wf_your_workflow_id_here

# ChatKit Domain Public Key (from OpenAI Platform > Security > Domain Allowlist)
# Generate this at: https://platform.openai.com/settings/organization/security/domain_allowlist
OPENAI_DOMAIN_PK=domain_pk_your_domain_key_here
