{
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    {
      "source": "/api/chat/session",
      "destination": "/api/chat/session"
    },
    {
      "source": "/api/chat/health",
      "destination": "/api/chat/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}