# .env is better suited for public variables, ie, variables that should not commited
# For secret variables is better to use DevServerControl tool with set_env_variable: ["KEY", "SECRET"]

# https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
PING_MESSAGE="ping pong"

# IMPORTANT: OPENAI_API_KEY is set via environment variables in production
# DO NOT ADD IT HERE - Use DevServerControl set_env_variable instead
# This prevents accidentally committing secrets to the repository

# ============================================
# STRAPI CMS CONFIGURATION
# ============================================
# Set these via DevServerControl tool (set_env_variable) for production
# Do NOT commit secrets to .env
STRAPI_URL=http://localhost:1337
# STRAPI_API_TOKEN - Use set_env_variable in DevServerControl
